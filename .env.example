# Server-only Supabase project URL.
SUPABASE_URL=https://your-project.supabase.co

# Server-only value: do not expose it in browser code or commit .env.local.
SUPABASE_API_KEY=

# Required in the Telegram authentication phase.
TELEGRAM_BOT_TOKEN=

# Random server-only secret used to validate Telegram webhook requests.
TELEGRAM_WEBHOOK_SECRET=

# Telegram ID(s) allowed to approve pending job posts, comma-separated.
ADMIN_TELEGRAM_IDS=

# Gemini API key. Keep it server-only; never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Gemini model used to turn raw vacancy text into JobTop fields.
GEMINI_MODEL=gemini-3.6-flash

# Secret for the server-to-server vacancy importer (cron/worker only).
AI_IMPORT_SECRET=

# Public Telegram channel usernames that the bot is allowed to import from.
# The bot must be added as an administrator to every listed channel.
AI_IMPORT_CHANNEL_USERNAMES=kunlikishlaruz24
